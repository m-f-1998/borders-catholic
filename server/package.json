{
  "name": "borders-catholic-server",
  "version": "1.0.0",
  "description": "Server for Borders Catholic website",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prestart": "npm i",
    "start": "node --env-file=.env --watch ./ index.js",
    "dev": "npm run prestart && npx --yes nodemon -e ts --exec \"tsc && node ./dist/index.js\"",
    "lint": "npx --yes eslint",
    "lint:fix": "npx --yes eslint --fix",
    "tsc-verify": "npx --yes tsc --noEmit"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "body-parser": "^2.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "googleapis": "^188.0.0",
    "mime": "^4.1.1",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "volta": {
    "node": "24.22.1"
  }
}
